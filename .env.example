# ==============================================================================
# OTIS COMMERCIAL CLEANING - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and populate with production credentials for Vercel.

# ------------------------------------------------------------------------------
# 1. Google Firebase Admin SDK (Firestore Database & Auth)
# ------------------------------------------------------------------------------
# In Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
FIREBASE_PROJECT_ID="otis-commercial-cleaning"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@otis-commercial-cleaning.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 2. Odoo ERP XML-RPC Integration
# ------------------------------------------------------------------------------
# Production or staging Odoo SaaS URL, database name, user email, and API key/password
ODOO_URL="https://otis.odoo.com"
ODOO_DB="otis"
ODOO_USER="info@otiscc.ca"
ODOO_PASSWORD="your-odoo-api-key-or-password"

# ------------------------------------------------------------------------------
# 3. Google Gemini AI API (Clara Inbound & Valérie Sales Drafter)
# ------------------------------------------------------------------------------
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY="AIzaSy..."

# ------------------------------------------------------------------------------
# 4. SendGrid Inbound Parse & Webhook Verification
# ------------------------------------------------------------------------------
# SendGrid API key for outbound pitches and public key for verifying inbound webhooks
SENDGRID_API_KEY="SG.xxxxx"
SENDGRID_WEBHOOK_VERIFICATION_KEY="MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAE..."

# ------------------------------------------------------------------------------
# 5. Executive ERP Dashboard Authentication (agent_hub.html)
# ------------------------------------------------------------------------------
# Master access PIN for Zan / Executive Staff (default: 8842) and JWT signing secret
ERP_ACCESS_PIN="8842"
JWT_SECRET="otis-executive-jwt-secret-key-montreal-2026"
