{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/fr/imgs/:path*", "destination": "/imgs/:path*" },
    { "source": "/services/imgs/:path*", "destination": "/imgs/:path*" },
    { "source": "/sectors/imgs/:path*", "destination": "/imgs/:path*" },
    { "source": "/fr/services/imgs/:path*", "destination": "/imgs/:path*" },
    { "source": "/crew", "destination": "/internal/field_app.html" },
    { "source": "/app", "destination": "/internal/field_app.html" },
    { "source": "/api/:endpoint", "destination": "/api/:endpoint.js" },
    { "source": "/api/internal/:endpoint", "destination": "/api/internal/:endpoint.js" }
  ],
  "redirects": [
    {
      "source": "/otis-final-v2_11",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/otis-final-v2_11.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/agent_hub.html",
      "destination": "/internal/command-center",
      "permanent": true
    },
    {
      "source": "/agent_hub",
      "destination": "/internal/command-center",
      "permanent": true
    },
    {
      "source": "/internal/agent_hub.html",
      "destination": "/internal/command-center",
      "permanent": true
    },
    {
      "source": "/internal/agent_hub",
      "destination": "/internal/command-center",
      "permanent": true
    },
    {
      "source": "/crm.html",
      "destination": "/internal/crm",
      "permanent": true
    },
    {
      "source": "/crm",
      "destination": "/internal/crm",
      "permanent": true
    },
    {
      "source": "/erp.html",
      "destination": "/internal/erp",
      "permanent": true
    },
    {
      "source": "/erp",
      "destination": "/internal/erp",
      "permanent": true
    },
    {
      "source": "/leads.html",
      "destination": "/internal/leads",
      "permanent": true
    },
    {
      "source": "/leads",
      "destination": "/internal/leads",
      "permanent": true
    },
    {
      "source": "/equipment.html",
      "destination": "/internal/equipment",
      "permanent": true
    },
    {
      "source": "/equipment",
      "destination": "/internal/equipment",
      "permanent": true
    },
    {
      "source": "/erp-report.html",
      "destination": "/internal/erp-report",
      "permanent": true
    },
    {
      "source": "/erp-report",
      "destination": "/internal/erp-report",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/internal/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}
