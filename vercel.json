{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/fr/imgs/:path*", "destination": "/imgs/:path*" },
    { "source": "/services/imgs/:path*", "destination": "/imgs/:path*" },
    { "source": "/sectors/imgs/:path*", "destination": "/imgs/:path*" },
    { "source": "/fr/services/imgs/:path*", "destination": "/imgs/:path*" },
    { "source": "/crew", "destination": "/internal/field_app.html" },
    { "source": "/app", "destination": "/internal/field_app.html" },
    { "source": "/api/:endpoint", "destination": "/api/:endpoint.js" },
    { "source": "/api/internal/:endpoint", "destination": "/api/internal/:endpoint.js" }
  ],
  "redirects": [
    {
      "source": "/otis-final-v2_11",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/otis-final-v2_11.html",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/internal/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}
